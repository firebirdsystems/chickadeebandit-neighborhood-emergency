{
  "scenarios": [
    {
      "name": "a child's check-in board shows their own response and no tally; an adult sees everyone's",
      "members": {
        "parent": "adult",
        "kid": "child"
      },
      "steps": [
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_neighborhood_emergency__checkin_events (id, title, message, active, created_by, created_by_name, created_at) VALUES ('ne-storm', ?, ?, 1, ?, ?, '2026-08-01T09:00:00Z')",
          "params": [
            "Ice storm",
            "Check in when you can.",
            "{{parent}}",
            "Parent Coordinator"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_neighborhood_emergency__checkin_responses (id, event_id, member_id, member_name, status, responded_at) VALUES ('ne-resp-parent', 'ne-storm', ?, ?, 'power', '2026-08-01T10:00:00Z')",
          "params": [
            "{{parent}}",
            "Pat Parent"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_neighborhood_emergency__checkin_responses (id, event_id, member_id, member_name, status, responded_at) VALUES ('ne-resp-kid', 'ne-storm', ?, ?, 'ok', '2026-08-01T11:00:00Z')",
          "params": [
            "{{kid}}",
            "Kim Kid"
          ]
        },
        {
          "action": "open",
          "as": "kid"
        },
        {
          "action": "expectVisible",
          "as": "kid",
          "selector": "[data-testid=\"app-tab\"][data-tab=\"storm\"]"
        },
        {
          "action": "click",
          "as": "kid",
          "selector": "[data-testid=\"app-tab\"][data-tab=\"storm\"]"
        },
        {
          "action": "expectVisible",
          "as": "kid",
          "selector": "[data-testid=\"checkin-board\"][data-event-id=\"ne-storm\"]"
        },
        {
          "action": "expectNoText",
          "as": "kid",
          "text": "Pat Parent"
        },
        {
          "action": "expectCount",
          "as": "kid",
          "selector": "[data-testid=\"checkin-row\"]",
          "count": 1
        },
        {
          "action": "expectCount",
          "as": "kid",
          "selector": "[data-testid=\"tally-pill\"]",
          "count": 0
        },
        {
          "action": "expectText",
          "as": "kid",
          "text": "Kim Kid"
        },
        {
          "action": "open",
          "as": "parent"
        },
        {
          "action": "expectVisible",
          "as": "parent",
          "selector": "[data-testid=\"app-tab\"][data-tab=\"storm\"]"
        },
        {
          "action": "click",
          "as": "parent",
          "selector": "[data-testid=\"app-tab\"][data-tab=\"storm\"]"
        },
        {
          "action": "expectVisible",
          "as": "parent",
          "selector": "[data-testid=\"checkin-board\"][data-event-id=\"ne-storm\"]"
        },
        {
          "action": "expectCount",
          "as": "parent",
          "selector": "[data-testid=\"checkin-row\"]",
          "count": 2
        },
        {
          "action": "expectText",
          "as": "parent",
          "text": "Pat Parent"
        },
        {
          "action": "expectText",
          "as": "parent",
          "text": "No power / water: 1",
          "selector": "[data-testid=\"tally-pill\"][data-status=\"power\"]"
        }
      ]
    },
    {
      "name": "in a shared space the coordinator group and the steward see every check-in response and the tally; a plain participant sees only their own",
      "context": "shared_space",
      "members": {
        "steward": "admin",
        "cora": "adult",
        "pat": "adult"
      },
      "steps": [
        {
          "action": "seedGroup",
          "group": "coord",
          "name": "Block Coordinators",
          "members": [
            "cora"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_neighborhood_emergency__settings (key, value) VALUES ('coordinator_group_id', ?)",
          "params": [
            "{{group:coord}}"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_neighborhood_emergency__checkin_events (id, title, message, active, created_by, created_by_name, created_at) VALUES ('ne-flood', ?, ?, 1, ?, ?, '2026-08-01T09:00:00Z')",
          "params": [
            "River flood",
            "Check in when you can.",
            "{{cora}}",
            "Cora Coordinator"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_neighborhood_emergency__checkin_responses (id, event_id, member_id, member_name, status, responded_at) VALUES ('ne-resp-cora', 'ne-flood', ?, ?, 'power', '2026-08-01T10:00:00Z')",
          "params": [
            "{{cora}}",
            "Cora Coordinator"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_neighborhood_emergency__checkin_responses (id, event_id, member_id, member_name, status, responded_at) VALUES ('ne-resp-pat', 'ne-flood', ?, ?, 'ok', '2026-08-01T11:00:00Z')",
          "params": [
            "{{pat}}",
            "Pat Plain"
          ]
        },
        {
          "action": "open",
          "as": "cora"
        },
        {
          "action": "expectVisible",
          "as": "cora",
          "selector": "[data-testid=\"app-tab\"][data-tab=\"storm\"]"
        },
        {
          "action": "click",
          "as": "cora",
          "selector": "[data-testid=\"app-tab\"][data-tab=\"storm\"]"
        },
        {
          "action": "expectVisible",
          "as": "cora",
          "selector": "[data-testid=\"checkin-board\"][data-event-id=\"ne-flood\"]"
        },
        {
          "action": "expectCount",
          "as": "cora",
          "selector": "[data-testid=\"checkin-row\"]",
          "count": 2
        },
        {
          "action": "expectText",
          "as": "cora",
          "selector": "[data-testid=\"checkin-row\"][data-response-id=\"ne-resp-pat\"]",
          "text": "Pat Plain"
        },
        {
          "action": "expectText",
          "as": "cora",
          "selector": "[data-testid=\"tally-pill\"][data-status=\"ok\"]",
          "text": "We're OK: 1"
        },
        {
          "action": "expectText",
          "as": "cora",
          "selector": "[data-testid=\"tally-pill\"][data-status=\"power\"]",
          "text": "No power / water: 1"
        },
        {
          "action": "expectVisible",
          "as": "cora",
          "selector": "[data-testid=\"close-checkin\"]"
        },
        {
          "action": "expectCount",
          "as": "cora",
          "selector": "[data-testid=\"own-status-note\"]",
          "count": 0
        },
        {
          "action": "open",
          "as": "pat"
        },
        {
          "action": "expectVisible",
          "as": "pat",
          "selector": "[data-testid=\"app-tab\"][data-tab=\"storm\"]"
        },
        {
          "action": "click",
          "as": "pat",
          "selector": "[data-testid=\"app-tab\"][data-tab=\"storm\"]"
        },
        {
          "action": "expectVisible",
          "as": "pat",
          "selector": "[data-testid=\"checkin-board\"][data-event-id=\"ne-flood\"]"
        },
        {
          "action": "expectCount",
          "as": "pat",
          "selector": "[data-testid=\"checkin-row\"]",
          "count": 1
        },
        {
          "action": "expectText",
          "as": "pat",
          "selector": "[data-testid=\"checkin-row\"][data-response-id=\"ne-resp-pat\"]",
          "text": "Pat Plain"
        },
        {
          "action": "expectCount",
          "as": "pat",
          "selector": "[data-testid=\"close-checkin\"]",
          "count": 0
        },
        {
          "action": "expectCount",
          "as": "pat",
          "selector": "[data-testid=\"tally-pill\"]",
          "count": 0
        },
        {
          "action": "expectVisible",
          "as": "pat",
          "selector": "[data-testid=\"own-status-note\"]"
        },
        {
          "action": "expectNoText",
          "as": "pat",
          "text": "Cora Coordinator",
          "selector": "[data-testid=\"checkin-board\"][data-event-id=\"ne-flood\"]"
        },
        {
          "action": "open",
          "as": "steward"
        },
        {
          "action": "expectVisible",
          "as": "steward",
          "selector": "[data-testid=\"app-tab\"][data-tab=\"storm\"]"
        },
        {
          "action": "click",
          "as": "steward",
          "selector": "[data-testid=\"app-tab\"][data-tab=\"storm\"]"
        },
        {
          "action": "expectVisible",
          "as": "steward",
          "selector": "[data-testid=\"checkin-board\"][data-event-id=\"ne-flood\"]"
        },
        {
          "action": "expectCount",
          "as": "steward",
          "selector": "[data-testid=\"checkin-row\"]",
          "count": 2
        },
        {
          "action": "expectText",
          "as": "steward",
          "selector": "[data-testid=\"checkin-row\"][data-response-id=\"ne-resp-cora\"]",
          "text": "Cora Coordinator"
        },
        {
          "action": "expectText",
          "as": "steward",
          "selector": "[data-testid=\"tally-pill\"][data-status=\"power\"]",
          "text": "No power / water: 1"
        },
        {
          "action": "expectCount",
          "as": "steward",
          "selector": "[data-testid=\"own-status-note\"]",
          "count": 0
        },
        {
          "action": "expectCount",
          "as": "steward",
          "selector": "[data-testid=\"close-checkin\"]",
          "count": 0
        },
        {
          "action": "expectVisible",
          "as": "steward",
          "selector": "[data-testid=\"close-note\"]"
        },
        {
          "action": "expectCount",
          "as": "cora",
          "selector": "[data-testid=\"close-note\"]",
          "count": 0
        },
        {
          "action": "expectCount",
          "as": "pat",
          "selector": "[data-testid=\"close-note\"]",
          "count": 0
        }
      ]
    }
  ]
}
